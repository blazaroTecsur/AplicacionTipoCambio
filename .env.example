# Copiar este archivo como ".env" y completar con valores reales.
# El archivo ".env" está en .gitignore y NUNCA debe subirse al repositorio.

# Base de datos MySQL (usada por api y worker)
MYSQL_ROOT_PASSWORD=CAMBIAR_PASSWORD
MYSQL_DATABASE=tasa_cambio_db
DB_CONNECTION_STRING=Server=db;Port=3306;Database=tasa_cambio_db;User=root;Password=CAMBIAR_PASSWORD;

# Seguridad de la API
API_KEY=CAMBIAR_EN_PRODUCCION

# SBS
SBS_TOKEN=CAMBIAR_EN_PRODUCCION

# Puertos expuestos en el host (cambiar si ya están en uso)
NGINX_PORT=80
DB_PORT=3306

# Seq (logging)
SEQ_ADMIN_PASSWORD=CAMBIAR_PASSWORD
