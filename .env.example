# Copiar este archivo como ".env" y completar con valores reales.
# El archivo ".env" está en .gitignore y NUNCA debe subirse al repositorio.

# Base de datos MySQL (usada por worker)
Mysql__RootPassword=CAMBIAR_PASSWORD
Mysql__DataBase=tasa_cambio_db
Mysql__DbConnectionString=Server=db;Port=3306;Database=tasa_cambio_db;User=root;Password=CAMBIAR_PASSWORD;

# Ventana de sincronización SBS (cambiar sin reconstruir la imagen)
Sbs__UrlXml=https://www.sbs.gob.pe/app/xmltipocambio/TC_TI_Portal_xml.xml
Sbs__UrlHtml=https://www.sbs.gob.pe/app/pp/SISTIP_PORTAL/Paginas/Publicacion/TipoCambioPromedio.aspx
Sbs__HoraInicioRegistro=21
Sbs__HoraFinRegistro=4
Sbs__IntervaloBusquedaMinutos=30
Sbs__ValidacionPartesEnteras=2
Sbs__ValidacionPartesDecimales=3
Sbs__Moneda0=USD
Sbs__Moneda1=EUR

# Infor SyteLine IDO API (OAuth2 + IDO REST)
Infor__SsoBaseUrl=https://CAMBIAR_SSO_INFOR
Infor__ClientId=CAMBIAR_EN_PRODUCCION
Infor__ClientSecret=CAMBIAR_EN_PRODUCCION
Infor__ServiceAccountKey=CAMBIAR_EN_PRODUCCION
Infor__ServiceAccountSecret=CAMBIAR_EN_PRODUCCION
Infor__BaseUrl=https://CAMBIAR_HOST_SYTELINE/api/SyteLineRESTv2/IDORequestSvc
Infor__Tenant=CAMBIAR_EN_PRODUCCION
Infor__AppId=CAMBIAR_EN_PRODUCCION
Infor__Configuration=CAMBIAR_NOMBRE_CONFIGURACION_MONGOOSE

# Puerto expuesto en el host para MySQL (cambiar si ya está en uso)
Db__Port=3306

# Seq (logging)
Seq__AdminPassWord=CAMBIAR_PASSWORD

# NUGGET TECSUR
GitHub__User=CAMBIAR_EN_PRODUCCION
GitHub__NugetTecsurToken=CAMBIAR_EN_PRODUCCION
