# Copiar este archivo como ".env" y completar con valores reales.
# El archivo ".env" está en .gitignore y NUNCA debe subirse al repositorio.

# Base de datos MySQL (usada por worker)
MYSQL_ROOT_PASSWORD=CAMBIAR_PASSWORD
MYSQL_DATABASE=tasa_cambio_db
DB_CONNECTION_STRING=Server=db;Port=3306;Database=tasa_cambio_db;User=root;Password=CAMBIAR_PASSWORD;

# Ventana de sincronización SBS (cambiar sin reconstruir la imagen)
URL_XML=https://www.sbs.gob.pe/app/xmltipocambio/TC_TI_Portal_xml.xml
URL_HTML=https://www.sbs.gob.pe/app/pp/SISTIP_PORTAL/Paginas/Publicacion/TipoCambioPromedio.aspx
HORA_INICIO_REGISTRO=21
HORA_FIN_REGISTRO=3
INTERVALO_BUSQUEDA_MINUTOS=30
VALIDACION_PARTES_ENTERAS=2
VALIDACION_PARTES_DECIMALES=3
SBS_MONEDA_0=USD
SBS_MONEDA_1=EUR

# Infor SyteLine IDO API (OAuth2 + IDO REST)
INFOR_SSO_URL=https://CAMBIAR_SSO_INFOR
INFOR_CLIENT_ID=CAMBIAR_EN_PRODUCCION
INFOR_CLIENT_SECRET=CAMBIAR_EN_PRODUCCION
INFOR_SERVICE_ACCOUNT_KEY=CAMBIAR_EN_PRODUCCION
INFOR_SERVICE_ACCOUNT_SECRET=CAMBIAR_EN_PRODUCCION
INFOR_IDO_BASE_URL=https://CAMBIAR_HOST_SYTELINE/api/SyteLineRESTv2/IDORequestSvc
INFOR_TENANT=CAMBIAR_EN_PRODUCCION
INFOR_APP_ID=CAMBIAR_EN_PRODUCCION
INFOR_MONGOOSE=CAMBIAR_NOMBRE_CONFIGURACION_MONGOOSE

# Puerto expuesto en el host para MySQL (cambiar si ya está en uso)
DB_PORT=3306

# Seq (logging)
SEQ_ADMIN_PASSWORD=CAMBIAR_PASSWORD

# NUGGET TECSUR
GITHUB_USER=CAMBIAR_EN_PRODUCCION
NUGET_TECSUR_TOKEN=CAMBIAR_EN_PRODUCCION
