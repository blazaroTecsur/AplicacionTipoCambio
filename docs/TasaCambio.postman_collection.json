        "method": "GET",
        "header": [
          { "key": "X-Api-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/tipocambio/usd?anio=2025&mes=6",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "tipocambio", "usd"],
          "query": [
            { "key": "anio", "value": "2025" },
            { "key": "mes", "value": "6" }
          ]
        },
        "description": "Parámetros query 'anio' y 'mes' son opcionales."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"id\": 10,\n      \"codigoMoneda\": \"USD\",\n      \"fecha\": \"2025-06-01\",\n      \"valorCompra\": 3.700,\n      \"valorVenta\": 3.750,\n      \"tasaPromedio\": 3.725,\n      \"fuenteOrigen\": \"SBS\",\n      \"fechaSbs\": \"2025-06-01\",\n      \"detalleMoneda\": {\n        \"id\": 1,\n        \"codigo\": \"USD\",\n        \"descripcion\": \"Dólar Americano\",\n        \"simbolo\": \"$\",\n        \"codigoSunat\": \"02\",\n        \"descripcionIso4217\": \"USD\"\n      }\n    }\n  ],\n  \"message\": null,\n  \"errors\": []\n}"
        }
      ]
