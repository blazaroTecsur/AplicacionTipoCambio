          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "No requiere X-Api-Key."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [
            { "key": "Content-Type", "value": "text/plain" }
          ],
          "body": "Healthy"
        }
      ]
    },
