          ],
          "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"id\": 1,\n      \"codigo\": \"USD\",\n      \"descripcion\": \"Dólar Americano\",\n      \"simbolo\": \"$\",\n      \"codigoSunat\": \"02\",\n      \"descripcionIso4217\": \"USD\"\n    },\n    {\n      \"id\": 2,\n      \"codigo\": \"EUR\",\n      \"descripcion\": \"Euro\",\n      \"simbolo\": \"€\",\n      \"codigoSunat\": \"05\",\n      \"descripcionIso4217\": \"EUR\"\n    },\n    {\n      \"id\": 3,\n      \"codigo\": \"PEN\",\n      \"descripcion\": \"Sol Peruano\",\n      \"simbolo\": \"S/\",\n      \"codigoSunat\": \"01\",\n      \"descripcionIso4217\": \"PEN\"\n    }\n  ],\n  \"message\": null,\n  \"errors\": []\n}"
