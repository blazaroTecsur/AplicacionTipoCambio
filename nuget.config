<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org"    value="https://api.nuget.org/v3/index.json" />
    <add key="nuget.tecsur" value="https://nuget.pkg.github.com/sistecsur/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <nuget.tecsur>
      <add key="Username"          value="%GITHUB_USER%" />
      <add key="ClearTextPassword" value="%NUGET_TECSUR_TOKEN%" />
    </nuget.tecsur>
  </packageSourceCredentials>
</configuration>
